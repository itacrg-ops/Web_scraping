# Template di configurazione locale — COPIARE in `.env` e valorizzare.
# NON committare mai il file `.env` reale (è escluso da .gitignore).
# I valori qui sono segnaposto per l'ambiente locale su Docker Desktop.

# --- Ambiente ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database / cache (default coerenti col docker-compose.dev.yml) ---
DATABASE_URL=postgresql://ams:ams@postgres:5432/ams
REDIS_URL=redis://redis:6379/0

# --- Orchestrazione ---
TEMPORAL_HOST=temporal:7233
SCRAPING_TASK_QUEUE=scraping

# --- Azure AI Foundry (LLM/embedding — usato ANCHE in locale) ---
# Endpoint pubblico della risorsa Foundry/Azure OpenAI in region UE.
AZURE_FOUNDRY_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
LLM_MODEL_PRIMARY=
LLM_MODEL_SECONDARY=
EMBEDDING_MODEL=
LLM_MAX_RPM=60
LLM_MAX_TPM=60000

# --- Autenticazione a Foundry ---
# Opzione A (semplice): API key. Se valorizzata, HA LA PRECEDENZA e si usa
# endpoint + key (nessun service principal / ruolo necessario).
AZURE_OPENAI_API_KEY=
#
# Opzione B (keyless, consigliata in prod): DefaultAzureCredential.
#   In LOCALE: service principal di sviluppo (queste 3 variabili).
#   In PROD:   NON impostarle — si usa AKS Workload Identity (keyless).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Autenticazione console/API (MSAL / Entra ID) ---
# In locale l'auth e' DISATTIVA (utente dev fittizio). Per attivarla:
#   AUTH_MODE=entra e valorizza tenant + audience (guida: docs/MSAL_ENTRA_SETUP.md).
# L'audience e' l'Application ID URI dell'app API (es. api://<api-client-id>)
# oppure il suo client id. Deve combaciare con lo scope richiesto dalla SPA.
AUTH_MODE=disabled
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=

# Token di servizio per le chiamate interne worker -> API (POST /api/alerts).
# Vuoto in dev = endpoint interno aperto. In prod: valorizzalo (uguale per api e worker).
INTERNAL_API_TOKEN=

# Lato SPA (console React): DEVE combaciare con la config lato API.
#   VITE_AUTH_MODE=entra per attivare il login MSAL (default: disabled).
#   VITE_ENTRA_CLIENT_ID  = client id dell'app SPA su Entra.
#   VITE_ENTRA_TENANT_ID  = tenant id (GUID).
#   VITE_ENTRA_API_SCOPE  = scope dell'API (es. api://<api-client-id>/access_as_user).
VITE_AUTH_MODE=disabled
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=

# --- SAS Visual Investigator / Viya ---
# In locale: SVI_MODE=mock (nessuna Viya). Con un ambiente Viya di test:
# impostare SVI_MODE=live e VIYA_ENDPOINT, poi avviare col profilo `sas`.
SVI_MODE=mock
VIYA_ENDPOINT=
SVI_DATAHUB_BASE=
SVI_ALERTS_BASE=

# --- Entity Resolution (anti-omonimia) ---
# Per default il solo nome NON supera il gate: serve un CF/P.IVA in registro.
# true = consente la risoluzione probabilistica sul nome quando c'e' un unico
# candidato forte (allenta l'anti-omonimia: usare con cautela).
ALLOW_NAME_ONLY_RESOLUTION=false

# --- Object store (MinIO in locale, coerente col compose) ---
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=adverse-media-snapshots
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio12345

# --- Scraping / politeness ---
SCRAPER_USER_AGENT=AdverseMediaBot/0.1 (+contatto: esempio@amministrazione.it)
SCRAPER_DEFAULT_CRAWL_DELAY=2.0
SCRAPER_RESPECT_ROBOTS=true
