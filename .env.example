# Template di configurazione locale — COPIARE in `.env` e valorizzare.
# NON committare mai il file `.env` reale (è escluso da .gitignore).
# I valori qui sono solo segnaposto.

# --- Database (dati strutturati) ---
DATABASE_URL=postgresql://user:password@localhost:5432/adverse_media

# --- Cache / coda ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (classificazione FATF dual-LLM) ---
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL_PRIMARY=
LLM_MODEL_SECONDARY=

# --- Feed licenziati adverse media (spina dorsale) ---
DOWJONES_API_KEY=
LEXISNEXIS_API_KEY=
MOODYS_GRID_API_KEY=

# --- Integrazioni PA (via PDND / accordi) ---
PDND_CLIENT_ID=
PDND_KID=
ANAC_ESERVICE_BASE=
INFOCAMERE_USER=
INFOCAMERE_PASSWORD=

# --- Storage snapshot (object store WARC/HTML) ---
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=adverse-media-snapshots
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# --- Scraping / politeness ---
SCRAPER_USER_AGENT=AdverseMediaBot/0.1 (+contatto: esempio@amministrazione.it)
SCRAPER_DEFAULT_CRAWL_DELAY=2.0
SCRAPER_RESPECT_ROBOTS=true

# --- Ambiente ---
APP_ENV=development
LOG_LEVEL=INFO
