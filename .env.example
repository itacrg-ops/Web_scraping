# Template di configurazione locale — COPIARE in `.env` e valorizzare.
# NON committare mai il file `.env` reale (è escluso da .gitignore).
# I valori qui sono segnaposto per l'ambiente locale su Docker Desktop.

# --- Ambiente ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database / cache (default coerenti col docker-compose.dev.yml) ---
DATABASE_URL=postgresql://ams:ams@postgres:5432/ams
REDIS_URL=redis://redis:6379/0

# --- Orchestrazione ---
TEMPORAL_HOST=temporal:7233
SCRAPING_TASK_QUEUE=scraping

# --- Azure AI Foundry (LLM/embedding — usato ANCHE in locale) ---
# Endpoint pubblico della risorsa Foundry/Azure OpenAI in region UE.
AZURE_FOUNDRY_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
LLM_MODEL_PRIMARY=
LLM_MODEL_SECONDARY=
EMBEDDING_MODEL=
LLM_MAX_RPM=60
LLM_MAX_TPM=60000
# Redazione PII prima dell'invio all'LLM (CF, P.IVA, email, IBAN, telefoni).
# Attiva per default; metti false solo in ambienti senza egress esterno.
PII_REDACTION=true

# --- Autenticazione a Foundry ---
# Opzione A (semplice): API key. Se valorizzata, HA LA PRECEDENZA e si usa
# endpoint + key (nessun service principal / ruolo necessario).
AZURE_OPENAI_API_KEY=
#
# Opzione B (keyless, consigliata in prod): DefaultAzureCredential.
#   In LOCALE: service principal di sviluppo (queste 3 variabili).
#   In PROD:   NON impostarle — si usa AKS Workload Identity (keyless).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Autenticazione console/API (MSAL / Entra ID) ---
# In locale l'auth e' DISATTIVA (utente dev fittizio). Per attivarla:
#   AUTH_MODE=entra e valorizza tenant + audience (guida: docs/MSAL_ENTRA_SETUP.md).
# L'audience e' l'Application ID URI dell'app API (es. api://<api-client-id>)
# oppure il suo client id. Deve combaciare con lo scope richiesto dalla SPA.
AUTH_MODE=disabled
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=

# Token di servizio per le chiamate interne worker -> API (POST /api/alerts).
# Vuoto in dev = endpoint interno aperto. In prod: valorizzalo (uguale per api e worker).
INTERNAL_API_TOKEN=

# Lato SPA (console React): DEVE combaciare con la config lato API.
#   VITE_AUTH_MODE=entra per attivare il login MSAL (default: disabled).
#   VITE_ENTRA_CLIENT_ID  = client id dell'app SPA su Entra.
#   VITE_ENTRA_TENANT_ID  = tenant id (GUID).
#   VITE_ENTRA_API_SCOPE  = scope dell'API (es. api://<api-client-id>/access_as_user).
VITE_AUTH_MODE=disabled
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=

# --- SAS Visual Investigator / Viya ---
# In locale: SVI_MODE=mock (nessuna Viya). Con un ambiente Viya di test:
# impostare SVI_MODE=live e VIYA_ENDPOINT, poi avviare col profilo `sas`.
SVI_MODE=mock
VIYA_ENDPOINT=
SVI_DATAHUB_BASE=
SVI_ALERTS_BASE=

# --- Entity Resolution (anti-omonimia) ---
# Per default il solo nome NON supera il gate: serve un CF/P.IVA in registro.
# true = consente la risoluzione probabilistica sul nome quando c'e' un unico
# candidato forte (allenta l'anti-omonimia: usare con cautela).
ALLOW_NAME_ONLY_RESOLUTION=false
# Screening ESPLORATIVO: se true, un soggetto NON presente nel registro (senza
# CF/P.IVA né corrispondenza) viene risolto in modo PROVVISORIO e non autoritativo,
# così la pipeline procede comunque (utile in locale per provare qualsiasi nome).
# Default false = gate stretto (nessun giudizio senza Entity Resolution).
ALLOW_UNREGISTERED_SUBJECT=false
# Disambiguazione per CUP dell'intervento (B7): tra omonimi a registro, il legame
# persona<->CUP individua il soggetto giusto (riduce gli 'ambiguous'). Segnale
# forte: default attivo.
ALLOW_CUP_DISAMBIGUATION=true
# Similarità semantica via embedding (B7): fonde la stringa con l'embedding dei
# nomi (varianti/abbreviazioni). Richiede EMBEDDING_MODEL su Foundry; senza, resta
# la sola stringa. Default off.
USE_EMBEDDINGS=false
EMBEDDING_WEIGHT=0.4

# --- Web search (ricerca articoli adverse media) ---
# Provider: mock (default, nessuna rete) | gdelt (KEYLESS ma rate-limited/instabile)
# | brave (Brave Search API, a chiave, affidabile: chiave free su brave.com/search/api).
SEARCH_PROVIDER=mock
BRAVE_API_KEY=
SEARCH_MAX_RESULTS=10
# GDELT: filtro lingua (nome lingua GDELT, es. italian; vuoto = nessun filtro) e
# finestra temporale (es. 24h, 1w, 3m, 6m, 12m, 1y). Se la ricerca mirata non
# trova nulla, il gateway ripiega su nome-solo e poi senza vincolo di lingua.
SEARCH_DEFAULT_LANG=italian
SEARCH_TIMESPAN=12m
GDELT_ENDPOINT=https://api.gdeltproject.org/api/v2/doc/doc
# GDELT è rate-limited (~1 richiesta ogni pochi secondi per IP): il gateway
# distanzia le chiamate e su 429 fa alcuni retry con backoff. Ritocca se serve.
GDELT_MIN_INTERVAL=5.0
GDELT_RETRIES=2
# Cache in-memory delle ricerche (TTL secondi): evita di ribattere su GDELT per
# ricerche ripetute. 0 = disattivata.
SEARCH_CACHE_TTL=900
# Deduplica per dominio (un articolo per testata) e soglia minima di credibilità.
# Ordine: alta > media > sconosciuta > bassa. Valori MIN_CREDIBILITY:
#   none = nessun filtro (solo annotazione) · sconosciuta = escludi solo "bassa"
#   (blog/UGC) · media = solo testate a registro (whitelist) · alta = solo alta.
DEDUP_BY_DOMAIN=true
MAX_PER_DOMAIN=1
MIN_CREDIBILITY=none

# --- Object store (MinIO in locale, coerente col compose) ---
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=adverse-media-snapshots
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio12345

# --- Scraping / politeness ---
SCRAPER_USER_AGENT=AdverseMediaBot/0.1 (+contatto: esempio@amministrazione.it)
SCRAPER_DEFAULT_CRAWL_DELAY=2.0
SCRAPER_RESPECT_ROBOTS=true

# --- Headless browser per pagine JS-rendered (B6) ---
# Fallback a Chromium quando l'estrazione HTTP è povera (SPA/JS). Attivo per
# default; false per disattivarlo (immagine worker con Chromium comunque presente).
HEADLESS_FALLBACK=true
# Timeout (secondi) per il rendering headless della pagina.
HEADLESS_TIMEOUT=20
