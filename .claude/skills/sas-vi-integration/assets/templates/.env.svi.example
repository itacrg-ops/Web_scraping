# --- Integrazione SAS Visual Investigator (svi_core) --- Segreti SOLO qui, mai nel repo.
# In locale: SVI_MODE=mock (nessuna Viya, id fittizi). Con Viya: SVI_MODE=live.
SVI_MODE=mock
VIYA_ENDPOINT=                # es. https://viya.example.org (o il demo RACE)
# base URL derivati da VIYA_ENDPOINT; override solo se il routing differisce:
# SVI_ALERTS_BASE=
# SVI_DATAHUB_BASE=

# --- Auth (SASLogon) ---
#   oauth  = /SASLogon/oauth/token (client registrato) — consigliato pilota/prod
#   token  = bearer già ottenuto in SAS_BEARER_TOKEN (scade; test rapido)
#   broker = sidecar (SAS_TOKEN_BROKER_URL)
SVI_AUTH_MODE=oauth
SAS_OAUTH_GRANT=client_credentials   # client_credentials | password
SAS_CLIENT_ID=
SAS_CLIENT_SECRET=
SAS_USERNAME=                 # solo grant password
SAS_PASSWORD=                 # solo grant password
SAS_OAUTH_SCOPE=
SAS_BEARER_TOKEN=             # solo SVI_AUTH_MODE=token
SAS_TOKEN_BROKER_URL=http://sas-token-broker:8099/token

# --- Modello alert (ricavali con scripts/svi_inspect.py sull'ambiente) ---
SVI_ENTITY_TYPE=             # actionableEntityType (entity type creato in SVI)
SVI_QUEUE=                   # recommendedQueueId (coda con acceptManualAlerts=true)
SVI_ALERT_TYPE_CODE=strategy_default   # OBBLIGATORIO lato SVI (senza → errorCode 1008)
SVI_ALERT_ORIGIN=           # alertOriginCode (vuoto = omesso)

# --- Sezioni opzionali envelope (off al primo test) ---
SVI_SEND_ENRICHMENT=false            # enrichment[] → enrichmentJson sull'alert
SVI_SEND_SCENARIO_EVENTS=false       # scenarioFiredEvents[]
SVI_SEND_CONTRIBUTING_OBJECTS=false  # contributingObjects[]

# errorCode 1008 ("data error") è ambiguo: config errata per l'ambiente OPPURE duplicato.
# Default false = solleva (alert NON creato, errore visibile). true = trattalo come
# duplicato idempotente (solo su ambienti a riferimenti validi, per ripubblicazioni).
SVI_DEDUP_ON_1008=false

# --- Robustezza ---
SVI_MAX_RETRIES=3
SVI_RETRY_BACKOFF=1.5
SVI_REQUEST_TIMEOUT=30
SVI_IDEMPOTENCY_TTL=86400

# --- TLS ---
# DEMO self-signed → SVI_VERIFY_TLS=false (== curl -k, SOLO demo). Meglio: SVI_CA_BUNDLE.
SVI_VERIFY_TLS=true
SVI_CA_BUNDLE=
